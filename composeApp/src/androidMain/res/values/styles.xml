<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Beers" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/beers_background</item>
        <item name="android:statusBarColor">@color/beers_background</item>
    </style>

    <style name="Theme.Beers.Splash" parent="Theme.Beers">
        <item name="android:windowBackground">@drawable/splash_screen</item>
    </style>
</resources>
